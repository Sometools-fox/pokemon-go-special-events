{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pokémon GO Special Events V2",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "schemaVersion",
      "id",
      "name",
      "schedule",
      "regions",
      "locations",
      "locationStatus",
      "specialRewards",
      "sources",
      "dataQuality",
      "createdAt",
      "updatedAt"
    ],
    "properties": {
      "schemaVersion": {
        "const": 2
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "name": {
        "type": "string"
      },
      "schedule": {
        "type": "object",
        "required": [
          "startDate",
          "endDate",
          "timeNote",
          "timeStatus"
        ],
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "timeNote": {
            "type": "string"
          },
          "timeStatus": {
            "enum": [
              "provided",
              "not_provided",
              "uncertain"
            ]
          }
        }
      },
      "regions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "locations": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "lat",
            "lng",
            "note",
            "type",
            "coordinateStatus"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "lat": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -180,
              "maximum": 180
            },
            "note": {
              "type": "string"
            },
            "type": {
              "enum": [
                "primary",
                "additional"
              ]
            },
            "coordinateStatus": {
              "enum": [
                "provided",
                "not_provided",
                "uncertain"
              ]
            }
          }
        }
      },
      "locationStatus": {
        "enum": [
          "provided",
          "partial",
          "not_provided",
          "uncertain"
        ]
      },
      "specialRewards": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "details": {
        "type": "array"
      },
      "notes": {
        "type": "array"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "const": "user_provided"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "dataQuality": {
        "type": "object",
        "required": [
          "gpsStatus",
          "unresolved"
        ],
        "properties": {
          "gpsStatus": {
            "enum": [
              "complete",
              "partial",
              "not_provided",
              "uncertain"
            ]
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "createdAt": {
        "type": "string",
        "format": "date"
      },
      "updatedAt": {
        "type": "string",
        "format": "date"
      }
    }
  }
}
