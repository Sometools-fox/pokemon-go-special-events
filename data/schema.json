{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pokemon GO Special Event",
  "type": "object",
  "required": [
    "id",
    "name",
    "startDate",
    "endDate",
    "regions",
    "locations",
    "specialRewards",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "startDate": {
      "type": "string"
    },
    "endDate": {
      "type": "string"
    },
    "timeNote": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "lat": {
            "type": [
              "number",
              "null"
            ]
          },
          "lng": {
            "type": [
              "number",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "specialRewards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "name"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "shiny": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "details": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lastUpdated": {
      "type": "string"
    }
  }
}